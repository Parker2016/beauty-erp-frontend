# ==========================================
# React (Vite) 前端專屬 .gitignore
# ==========================================

# 1. Node 模組 (絕對不能推上 Git 的大魔王)
node_modules/
.npm/

# 2. Mac 系統自動產生的垃圾檔 (Mac 用戶必備)
.DS_Store
.AppleDouble
.LSOverride
Icon

# 3. Vite 打包產出的編譯檔案 (雲端不需要，要部署時再 Build)
dist/
dist-ssr/
build/

# 4. 環境變數與機密資訊 (保護你的 API 網址或金鑰)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 5. 除錯日誌 (Logs)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. 編輯器與 IDE 設定 (避免蓋掉團隊其他人的編輯器設定)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. TypeScript 快取 (未來如果有升級 TypeScript 會用到)
*.tsbuildinfo